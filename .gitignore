/Library/
/logs/
/out/
/.vs/
/imgui.ini
*.user

# ビルド成果物と作業用キャッシュは共有しない。
/build/
/Build/
/Temp/
/temp/
/tmp/
/.cache/
*.tmp
*.temp
*.log

# 個人環境の設定と OS の補助ファイルを除外する。
/.mcp.json
/CMakeUserPresets.json
.DS_Store
Thumbs.db

# 設計・引き継ぎ・報告はローカルで保管する。
AGENTS.md
CLAUDE.md
/Docs/
/docs/
/Design/
/design/
/Reports/
/reports/
/*設計*.md
/*设计*.md
/*引き継ぎ*.md
/*交接*.md
/*報告*.md
/*报告*.md

# 秘密情報は登録せず、値を含まない設定例だけを許可する。
.env
.env.*
!.env.example
!.env.template
.secrets/
*.pem
*.key
*.p12
*.pfx
id_rsa
id_ed25519

# Blender の作業ファイルは自動バックアップも含めてローカルに残す。
*.blend
*.blend[0-9]*
*.blend@

# 素材・レベル生成時の Python キャッシュはローカルに残す。
__pycache__/

# 工場セットのプレビュー画像と画面テクスチャ等の作業キャッシュはローカルに残す。
/ArtSource/FactorySet01/Previews/
/ArtSource/FactorySet01/Temp/

# レベルセットと画面キットのプレビュー・作業キャッシュはローカルに残す。
/ArtSource/LevelSet01/Previews/
/ArtSource/LevelSet01/Temp/
/ArtSource/ScreenStyle07/Temp/

# 外部の表示機モデル：確認画像と説明書きはローカルに残す。
/ArtSource/ExternalDisplays01/Previews/
/ArtSource/ExternalDisplays01/*.txt

# 素材を作る Python スクリプトと、その雛形は実行時に使わないのでローカルに残す。
/ArtSource/**/*.py
/ArtSource/ScreenStyle07/model_meta_template.json
