/Library/
/logs/
/out/
/.vs/
/imgui.ini
*.user

# ビルド成果物と作業用キャッシュは共有しない。
/build/
/Build/
/Temp/
/temp/
/tmp/
/.cache/
*.tmp
*.temp
*.log

# 個人環境の設定と OS の補助ファイルを除外する。
/.mcp.json
/CMakeUserPresets.json
.DS_Store
Thumbs.db

# 設計・引き継ぎ・報告はローカルで保管する。
AGENTS.md
CLAUDE.md
/Docs/
/docs/
/Design/
/design/
/Reports/
/reports/
/*設計*.md
/*设计*.md
/*引き継ぎ*.md
/*交接*.md
/*報告*.md
/*报告*.md

# 秘密情報は登録せず、値を含まない設定例だけを許可する。
.env
.env.*
!.env.example
!.env.template
.secrets/
*.pem
*.key
*.p12
*.pfx
id_rsa
id_ed25519

# Blender の作業ファイルは自動バックアップも含めてローカルに残す。
*.blend
*.blend[0-9]*
*.blend@

# このセットの派生プレビューと検証結果だけを除外し、資産一覧と再生成スクリプトは残す。
/ArtSource/ModularSet01/Previews/
/ArtSource/ModularSet01/validation_report.json
/ArtSource/ModularSet01/roundtrip_report.json
# 検証専用スクリプトはローカルに残し、生成・FBX 出力スクリプトは追跡する。
/ArtSource/ModularSet01/verify_exports.py
/ArtSource/ModularSet01/verify_blender_roundtrip.py

# Set02 のプレビュー・作業キャッシュ・一覧を含む検証報告はローカルに残す。
/ArtSource/ModularSet02/Previews/
/ArtSource/ModularSet02/Temp/
/ArtSource/ModularSet02/asset_manifest.json
/ArtSource/ModularSet02/verification*.json
/ArtSource/ModularSet02/verification*.py
/ArtSource/ModularSet02/verify*.py

# 素材・レベル生成時の Python キャッシュはローカルに残す。
__pycache__/

# 工場セットのプレビュー画像と画面テクスチャ等の作業キャッシュはローカルに残す。
/ArtSource/FactorySet01/Previews/
/ArtSource/FactorySet01/Temp/

# レベルセットと画面キットのプレビュー・作業キャッシュはローカルに残す。
/ArtSource/LevelSet01/Previews/
/ArtSource/LevelSet01/Temp/
/ArtSource/ScreenStyle07/Temp/

# 外部の表示機モデル：確認画像と説明書きはローカルに残す。
/ArtSource/ExternalDisplays01/Previews/
/ArtSource/ExternalDisplays01/*.txt

# 確認画像・検証・画風の試作用スクリプトはローカルに残す。
/ArtSource/ScreenGame06/preview_*.py
/ArtSource/Sprites04/check_*.py
/ArtSource/ScreenStyle07/*_study.py
/ArtSource/ScreenStyleStudy01/
/ArtSource/ScreenStyleStudy02/

# 素材を作る Python スクリプトは実行時に使わないのでローカルに残す。
/ArtSource/**/*.py
